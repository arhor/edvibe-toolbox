{
    "manifest_version": 3,
    "name": "Edvibe Toolbox",
    "version": "1.0",
    "description": "A universal toolkit for automation and backup on the Edvibe platform.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "*://*.edvibe.com/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.edvibe.com/*"
            ],
            "js": [
                "src/entrypoints/isolated.js"
            ],
            "run_at": "document_start",
            "world": "ISOLATED"
        },
        {
            "matches": [
                "*://*.edvibe.com/*"
            ],
            "js": [
                "src/entrypoints/main.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ]
}
