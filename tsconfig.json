{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "types": [
            "chrome"
        ]
    },
    "include": [
        "src/**/*.mjs",
        "src/**/*.js",
        "src/**/*.ts"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ]
}