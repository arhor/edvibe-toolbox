{
  "manifest_version": 3,
  "name": "Toolfox",
  "version": "1.0",
  "description": "A browser toolkit for productivity and workflow automation.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "js": [
        "src/content/isolated/index.js"
      ],
      "matches": [
        "*://*.edvibe.com/*"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "js": [
        "src/content/main/index.js"
      ],
      "matches": [
        "*://*.edvibe.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
