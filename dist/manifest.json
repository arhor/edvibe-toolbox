{
  "manifest_version": 3,
  "name": "Edvibe Toolbox",
  "version": "1.0",
  "description": "A universal toolkit for automation and backup on the Edvibe platform.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "js": [
        "src/entrypoints/isolated.js"
      ],
      "matches": [
        "*://*.edvibe.com/*"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "js": [
        "src/entrypoints/main.js"
      ],
      "matches": [
        "*://*.edvibe.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
