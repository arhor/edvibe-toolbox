{
  "name": "toolfox",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Browser extension toolkit for productivity workflows",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "check:build-output": "node scripts/check-build-output.js",
    "lint": "eslint . --fix",
    "test": "tsx --test \"src/**/*.test.{js,ts}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "lit": "3.3.1",
    "turndown": "7.2.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/chrome": "0.2.2",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "eslint-plugin-better-mutation": "3.0.0",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-wc": "3.1.0",
    "globals": "17.9.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vite-plugin-zip-pack": "1.2.4"
  }
}
