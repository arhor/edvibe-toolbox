{
  "name": "edvibe-toolbox",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension utilities for Edvibe workflows",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./test-path-compat.cjs --test \"src/**/*.test.js\"",
    "test:components": "node scripts/run-component-tests.mjs",
    "test:ci": "npm test && npm run test:components"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "lit": "3.3.1",
    "turndown": "7.2.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@types/chrome": "0.2.2",
    "typescript": "6.0.3",
    "vite": "8.1.5"
  }
}
