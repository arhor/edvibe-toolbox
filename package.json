{
  "name": "edvibe-toolbox",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension utilities for Edvibe workflows",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "check:build-output": "node scripts/check-build-output.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.js\"",
    "test:ci": "npm test"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "lit": "3.3.1",
    "turndown": "7.2.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "10.0.1",
    "@rollup/plugin-swc": "^0.4.1",
    "@swc/core": "^1.15.47",
    "@types/chrome": "0.2.2",
    "eslint": "10.8.1",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-wc": "3.1.0",
    "globals": "17.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
